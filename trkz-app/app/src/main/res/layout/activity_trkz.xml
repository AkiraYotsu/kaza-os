<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Minimalist Session Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#050505"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TrKZ"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/txtSessionTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="  [Session 1]"
            android:textColor="#777777"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:letterSpacing="-0.03" />

        <Button
            android:id="@+id/btnNewSession"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="#151515"
            android:text="+ Session"
            android:textColor="#60a5fa"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1a1a1a"
        android:layout_below="@id/topBar" />

    <!-- Extra Keys Bar (Fixed above prompt input) -->
    <HorizontalScrollView
        android:id="@+id/extraKeysScroll"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#0a0a0a"
        android:layout_above="@+id/promptInputContainer"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/extraKeysLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:gravity="center_vertical">

            <Button android:id="@+id/keyCtrl" android:layout_width="48dp" android:layout_height="24dp" android:text="CTRL" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keySlash" android:layout_width="38dp" android:layout_height="24dp" android:text="/" android:textColor="#60a5fa" android:textSize="12sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyTab" android:layout_width="42dp" android:layout_height="24dp" android:text="TAB" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyEsc" android:layout_width="42dp" android:layout_height="24dp" android:text="ESC" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyHome" android:layout_width="46dp" android:layout_height="24dp" android:text="HOME" android:textColor="#888888" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyUp" android:layout_width="36dp" android:layout_height="24dp" android:text="▲" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyDown" android:layout_width="36dp" android:layout_height="24dp" android:text="▼" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyLeft" android:layout_width="36dp" android:layout_height="24dp" android:text="◄" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyRight" android:layout_width="36dp" android:layout_height="24dp" android:text="►" android:textColor="#ffffff" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyPgUp" android:layout_width="46dp" android:layout_height="24dp" android:text="PGUP" android:textColor="#888888" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyPgDn" android:layout_width="46dp" android:layout_height="24dp" android:text="PGDN" android:textColor="#888888" android:textSize="10sp" android:background="#181818" android:fontFamily="monospace" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Seamless Terminal Prompt Input Bar (Fixed at Bottom for 100% Continuous Typing) -->
    <LinearLayout
        android:id="@+id/promptInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/txtPromptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kaza@kernel:~$ "
            android:textColor="#34d399"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:letterSpacing="-0.03" />

        <EditText
            android:id="@+id/edtPromptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:textColor="#ffffff"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:letterSpacing="-0.03"
            android:inputType="textNoSuggestions|textMultiLine"
            android:imeOptions="actionSend"
            android:padding="0dp"
            android:cursorVisible="true" />
    </LinearLayout>

    <!-- Terminal Scroll History Output -->
    <ScrollView
        android:id="@+id/scrollConsole"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topDivider"
        android:layout_above="@id/extraKeysScroll"
        android:fillViewport="true"
        android:padding="6dp">

        <TextView
            android:id="@+id/txtConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:letterSpacing="-0.03"
            android:lineSpacingExtra="1dp"
            android:textIsSelectable="true"
            android:linksClickable="true" />
    </ScrollView>

</RelativeLayout>
